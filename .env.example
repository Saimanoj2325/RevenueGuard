# RevenueGuard AI — environment. Copy to .env (optional: the stack runs with zero keys in demo mode).
#   cp .env.example .env
# docker-compose.yml already wires inter-service URLs (http://api:8000, http://laya:8100, ...).
# Values marked "compose-managed" are set by docker-compose.yml; set them here only when running a service outside Docker.

# ---------------------------------------------------------------- core / secrets
# dev | prod (informational)
ENV=dev
# display name
APP_NAME="RevenueGuard AI"
# true = mock connectors + seeded PO-184 fixtures (zero keys); false = real connectors
DEMO_MODE=true
# signs user JWTs — change for anything non-local
JWT_SECRET=change-me-jwt-secret
# login token lifetime
JWT_TTL_MINUTES=720
# shared by api, worker, harness, wa-bridge for X-RG-Signature
INTERNAL_HMAC_SECRET=change-me-internal-hmac
# API: reject signed requests older than this
HMAC_MAX_SKEW_SECONDS=300
# harness / wa-bridge: same rule, Node services' name
HMAC_MAX_SKEW_SEC=300
# encrypts stored OAuth tokens; empty = derived from JWT_SECRET (dev only). Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FERNET_KEY=
# browser-facing API URL (OAuth redirects, media links)
PUBLIC_API_URL=http://localhost:8000
# browser-facing web URL
WEB_URL=http://localhost:3000
# Google/Zoho sign-in redirect URIs follow the address you opened the app on (localhost, a tunnel, a domain):
#   https://<that-address>/api-backend/connectors/{google|zoho}/callback  (Setup > Connections shows them, with Copy)
# GOOGLE_REDIRECT_URI / ZOHO_REDIRECT_URI below are only used when the API is called directly. Pin one address with:
# PUBLIC_WEB_URL=https://app.example.com
# comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000
# tenant that WhatsApp bridge events belong to
DEFAULT_TENANT_SLUG=demo
# auto | harness | builtin (auto = harness if reachable, else builtin in DEMO_MODE)
AGENT_RUNNER=auto
# run background jobs inside the API process (compose-managed: false, worker service does it)
INLINE_WORKER=false
# API + worker log level (mapped to LOG_LEVEL by compose)
API_LOG_LEVEL=INFO
# harness + wa-bridge log level (mapped to LOG_LEVEL by compose)
NODE_LOG_LEVEL=info
# LOG_LEVEL=                              # compose-managed per service (see the two lines above)
# OpenTelemetry export on/off
OTEL_ENABLED=false
# e.g. http://otel-collector:4318
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---------------------------------------------------------------- database / queue
# pgvector/pgvector:pg16 superuser
POSTGRES_USER=rg
# change for anything non-local
POSTGRES_PASSWORD=rg
# database name
POSTGRES_DB=revenueguard
# DATABASE_URL=postgresql+asyncpg://rg:rg@postgres:5432/revenueguard   # compose-managed (built from POSTGRES_*)
# REDIS_URL=redis://redis:6379/0          # compose-managed

# ---------------------------------------------------------------- object storage (MinIO / S3)
# s3 | local (compose-managed: s3)
STORAGE_BACKEND=s3
# used only when STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=/data/objects
# MINIO_ENDPOINT=http://minio:9000        # compose-managed
# also MinIO root user
MINIO_ACCESS_KEY=minioadmin
# also MinIO root password — change for anything non-local
MINIO_SECRET_KEY=minioadmin
# created by the minio-init one-shot service
MINIO_BUCKET=revenueguard

# ---------------------------------------------------------------- service URLs (compose-managed)
# INTERNAL_API_URL=http://api:8000        # how harness / wa-bridge reach the API (API's own setting)
# API_URL=http://api:8000                 # harness / wa-bridge name for the same thing
# LAYA_URL=http://laya:8100
# HARNESS_URL=http://harness:3100
# WA_BRIDGE_URL=http://wa-bridge:3001
# PORT=                                   # compose-managed per Node service (harness 3100, wa-bridge 3001); do not set globally
# HARNESS_PORT=3100                       # harness port fallback when PORT is unset
# WA_BRIDGE_PORT=3001                     # wa-bridge port fallback when PORT is unset
# HOST=0.0.0.0                            # Node services bind address

# ---------------------------------------------------------------- Google OAuth (Gmail, Sheets, Drive)
# Google Cloud OAuth client (Web application)
GOOGLE_CLIENT_ID=change-me.apps.googleusercontent.com
# OAuth client secret
GOOGLE_CLIENT_SECRET=change-me
# must be listed in the OAuth client
GOOGLE_REDIRECT_URI=http://localhost:8000/connectors/google/callback
# Gmail polling interval
GMAIL_POLL_SECONDS=60
# Gmail search used for intake
GMAIL_QUERY=newer_than:14d

# ---------------------------------------------------------------- Zoho Books (India DC: accounts.zoho.in / www.zohoapis.in/books/v3)
# Zoho API console client (Server-based app)
ZOHO_CLIENT_ID=change-me
# Zoho client secret
ZOHO_CLIENT_SECRET=change-me
# must match the Zoho client
ZOHO_REDIRECT_URI=http://localhost:8000/connectors/zoho/callback
# data centre suffix: in -> accounts.zoho.in, www.zohoapis.in
ZOHO_DC=in
# Zoho Books organization_id (sandbox org for demos)
ZOHO_ORG_ID=

# ---------------------------------------------------------------- LLM routing (all OpenAI-compatible)
# harness provider fallback order
LLM_PROVIDER_ORDER=nim,groq,ollama
# API per-call LLM timeout
LLM_TIMEOUT_SECONDS=45
# harness per-call LLM timeout
LLM_TIMEOUT_MS=60000
# harness sampling temperature
LLM_TEMPERATURE=0.1
# harness max output tokens per call
LLM_MAX_OUTPUT_TOKENS=2048
# harness: scripted LLM responses (zero keys). Set false once a key is set
MOCK_LLM=true
# dsh (DeepSeek Harness) | builtin agent loop
HARNESS_ENGINE=dsh
# fall back to builtin loop if dsh packages fail to load
HARNESS_ENGINE_FALLBACK=true

# ---------------------------------------------------------------- NVIDIA NIM
# nvapi-... (empty = NIM disabled)
NVIDIA_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# text reasoning model
NIM_MODEL=deepseek-ai/deepseek-v4.1-flash
# field extraction from images
NIM_VISION_MODEL=deepseek-ai/deepseek-v4.1-flash
# PDF / document parsing
NIM_PARSE_MODEL=nvidia/nemotron-parse
# audio fallback
NIM_OMNI_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# harness: force-disable NIM even with a key
NIM_DISABLED=false

# ---------------------------------------------------------------- Groq
# gsk_... (empty = Groq disabled)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# text fallback model
GROQ_MODEL=openai/gpt-oss-120b
# voice-note transcription, last live fallback (guarded against hallucinations)
GROQ_STT_MODEL=whisper-large-v3
# harness: force-disable Groq even with a key
GROQ_DISABLED=false

# ---------------------------------------------------------------- Sarvam AI (speech-to-text, first choice)
# voice notes: Sarvam -> NIM omni -> Groq Whisper -> (DEMO_MODE only) fixture transcript
# api-subscription-key from dashboard.sarvam.ai (empty = Sarvam disabled)
SARVAM_API_KEY=
# saaras:v3 (supports SARVAM_STT_MODE) | saaras:v4 (supports keyterms: PO numbers, customer/item names)
SARVAM_STT_MODEL=saaras:v3
# v3 only: transcribe | translate | verbatim | translit | codemix (Hinglish, keeps English words in Latin script)
SARVAM_STT_MODE=codemix

# ---------------------------------------------------------------- Ollama (local, optional)
# Ollama on the Docker host
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# local model
OLLAMA_MODEL=qwen3:8b
# any non-empty string
OLLAMA_API_KEY=ollama
# API: use Ollama as last-resort provider
OLLAMA_ENABLED=false
# harness: inverse flag — set false (and OLLAMA_ENABLED=true) to use Ollama
OLLAMA_DISABLED=true

# ---------------------------------------------------------------- cost rates & budgets (INR)
# assumed INR per 1M input tokens
NIM_COST_INR_PER_MTOK_IN=25
# assumed INR per 1M output tokens
NIM_COST_INR_PER_MTOK_OUT=100
GROQ_COST_INR_PER_MTOK_IN=13
GROQ_COST_INR_PER_MTOK_OUT=63
OLLAMA_COST_INR_PER_MTOK_IN=0
OLLAMA_COST_INR_PER_MTOK_OUT=0
# API: cap per LLM call
LLM_MAX_COST_INR_PER_CALL=5.0
# per case: max agent runs before ESCALATED
CASE_BUDGET_MAX_AGENT_RUNS=12
# per case: max spend before ESCALATED
CASE_BUDGET_MAX_COST_INR=25.0
# API -> harness budget per run
AGENT_MAX_STEPS=8
AGENT_MAX_TOKENS=40000
AGENT_MAX_SECONDS=120
AGENT_MAX_COST_INR=5.0
# harness defaults when a run omits a budget
DEFAULT_MAX_STEPS=8
DEFAULT_MAX_TOKENS=40000
DEFAULT_MAX_SECONDS=120
DEFAULT_MAX_COST_INR=5
# adaptive | fixed (fixed tool sequence = eval baseline)
INVESTIGATION_MODE=adaptive
# below this, case goes to the triage queue
TRIAGE_CONFIDENCE_THRESHOLD=0.7
# amounts above this need 2 distinct approvers
APPROVAL_TWO_PERSON_THRESHOLD_INR=100000

# ---------------------------------------------------------------- harness runtime limits
# circuit breaker: failures before opening
CB_FAILURE_THRESHOLD=3
# circuit breaker cooldown
CB_COOLDOWN_MS=30000
# per tool call to the API
TOOL_TIMEOUT_MS=20000
# truncate tool results fed to the model
MAX_TOOL_RESULT_CHARS=12000
# parallel agent runs
MAX_CONCURRENT_RUNS=8
# invalid-output retries (capped at 2)
MAX_REPAIR_RETRIES=2
# stop streaming agent events to the API
EVENTS_DISABLED=false

# ---------------------------------------------------------------- Laya decision service
# build arg: torch wheel index (CPU)
TORCH_INDEX=https://download.pytorch.org/whl/cpu
# build arg used by docker-compose.gpu.yml
TORCH_INDEX_CUDA=https://download.pytorch.org/whl/cu121
# cpu | cuda | empty = auto-detect
LAYA_DEVICE=
# device used by docker-compose.gpu.yml
LAYA_DEVICE_GPU=cuda
# english | multilingual | typed-decisions | empty = auto-route
LAYA_MODEL=
# 1 = skip weights, always use keyword heuristic (fallback:true)
LAYA_DISABLE=0
# load weights at startup in the background
LAYA_PRELOAD=1
# max models kept in memory
LAYA_MAX_LOADED=2
# models warmed at startup
LAYA_WARM_MODELS=english,multilingual
# HF_HOME=/models                         # compose-managed: Hugging Face cache on the hf_cache volume

# ---------------------------------------------------------------- WhatsApp bridge (Baileys)
# true = simulated WhatsApp (no phone); false = real QR pairing
WA_MOCK=true
# mock: delay before "open"
WA_MOCK_AUTO_CONNECT_MS=1500
# require HMAC on GET endpoints too
WA_REQUIRE_HMAC_ON_GET=false
# WA_DATA_DIR=/data                       # compose-managed (wa_auth volume)
# WA_AUTH_DIR=/data/auth                  # default: $WA_DATA_DIR/auth
# WA_DB_PATH=/data/wa-bridge.sqlite       # default: $WA_DATA_DIR/wa-bridge.sqlite
# WA_MEDIA_DIR=/data/media                # default: $WA_DATA_DIR/media
# max inbound media size forwarded
WA_MAX_MEDIA_BYTES=16777216
# outbound rate limit
WA_SEND_RATE_PER_MIN=20
# min gap between sends
WA_SEND_MIN_INTERVAL_MS=1500
# reconnect backoff start
WA_RECONNECT_BASE_MS=1000
# reconnect backoff cap
WA_RECONNECT_MAX_MS=60000
# retry interval for events the API did not accept
WA_FORWARD_RETRY_MS=30000
# Baileys library log level
BAILEYS_LOG_LEVEL=warn
# device name shown in WhatsApp > Linked devices
WA_BROWSER_NAME=RevenueGuard

# ---------------------------------------------------------------- web (Next.js — baked at build time)
# API URL as seen from the browser
NEXT_PUBLIC_API_URL=http://localhost:8000
# empty = ws://<API host>/ws
NEXT_PUBLIC_WS_URL=
# true = client-side mock backend (no API); keep false with compose
NEXT_PUBLIC_MOCK=false
# NEXT_PUBLIC_BASE_PATH=                  # sub-path for static hosting only (not a Docker build arg)
# BUILD_STATIC=1                          # static export build (apps/web/out), not used by Docker

# ---------------------------------------------------------------- eval
# EVAL_RESULTS_PATH=/app/eval/results/latest.json   # compose-managed (./eval mounted at /app/eval)
