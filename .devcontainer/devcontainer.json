{
  "name": "RevenueGuard AI",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "enableNonRootDocker": "true"
    }
  },
  "forwardPorts": [3000, 8000, 9001],
  "portsAttributes": {
    "3000": {
      "label": "RevenueGuard Web",
      "onAutoForward": "openBrowser"
    },
    "8000": {
      "label": "RevenueGuard API"
    },
    "9001": {
      "label": "MinIO Console"
    }
  },
  "postCreateCommand": "cp -n .env.example .env"
}
