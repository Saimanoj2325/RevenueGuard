# Real API (default)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional; defaults to ws(s)://<API host>/ws
NEXT_PUBLIC_WS_URL=
# true = fully client-side mock backend (PO-184 story), no API needed
NEXT_PUBLIC_MOCK=false
# Sub-path when hosting the static demo (e.g. /revenueguard)
NEXT_PUBLIC_BASE_PATH=
